# Modelo das variáveis de ambiente do frontend (Vite).
#
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript público do site.
# Nunca coloque senhas, tokens ou outros segredos aqui.
#
# Arquivos usados pelo Vite:
#   .env.development  -> "npm run dev" (versionado)
#   .env.production   -> "npm run build" (versionado)
#   .env.local        -> sobrescreve os dois acima só na sua máquina (fora do git)
# Variáveis definidas na plataforma de hospedagem têm prioridade sobre os arquivos.

# URL pública do backend, sem barra no final.
# Desenvolvimento: http://localhost:8080
# Produção (exemplo): https://pomohistoria-api.onrender.com
VITE_API_BASE_URL=http://localhost:8080

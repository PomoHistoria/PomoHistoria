# Modelo das variáveis de ambiente do backend.
#
# Desenvolvimento local: copie para "backend/.env" e preencha. O arquivo .env é lido
# automaticamente quando o backend roda com o perfil "local" e NÃO vai para o git.
#
# Produção (Render): o .env NÃO é usado. Cadastre estas variáveis em
# Environment > Environment Variables no serviço do backend.
# Variáveis definidas no sistema/plataforma sempre têm prioridade sobre o arquivo.

# ---------- Banco de dados (obrigatório em produção) ----------
# Formato JDBC. A URL do Render vem como postgresql://usuario:senha@host:5432/banco:
# use só host:porta/banco com o prefixo jdbc:postgresql://
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pomohistoria
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
DB_POOL_SIZE=5

# ---------- Frontend autorizado pelo CORS (obrigatório em produção) ----------
# URLs separadas por vírgula, sem barra no final. Em produção: a URL pública do frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Conta administradora (opcional) ----------
# Cria a conta ADMIN na inicialização se o e-mail ainda não existir. Preencha os dois ou nenhum.
# Senha forte, com até 72 bytes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Sessão (opcional; os padrões já servem para produção) ----------
# Em produção, com front e back em domínios diferentes, use SESSION_COOKIE_SAME_SITE=none e SESSION_COOKIE_SECURE=true.
# O perfil "local" já usa lax/false automaticamente.
# SESSION_COOKIE_SAME_SITE=none
# SESSION_COOKIE_SECURE=true
# SESSION_TIMEOUT=30m

# ---------- Limite de tentativas de login (opcional) ----------
# LOGIN_MAX_FALHAS_POR_EMAIL=5
# LOGIN_MAX_FALHAS_POR_IP=50
# LOGIN_BLOQUEIO_MINUTOS=15
